{
  "name": "@doktool/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DokTool backend — NestJS modular monolith, the single source of truth for every rule.",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "openapi:generate": "npm run build && node dist/scripts/generate-openapi.js",
    "openapi:check": "npm run build && node dist/scripts/generate-openapi.js --check",
    "postinstall": "prisma generate",
    "admin:create": "npm run build && node --env-file-if-exists=.env dist/scripts/create-admin.js",
    "demo:seed": "npm run build && node --env-file-if-exists=.env dist/scripts/seed-demo.js",
    "medicalcul:extract": "npm run build && node dist/scripts/extract-medicalcul.js",
    "medicalcul:import": "npm run build && node --env-file-if-exists=.env dist/scripts/import-medicalcul.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@doktool/i18n": "0.1.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "acorn": "8.18.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "intl-messageformat": "12.1.2",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "otpauth": "9.5.2",
    "parse5": "8.0.1",
    "pg-boss": "12.34.0",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.7",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.11.0",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
