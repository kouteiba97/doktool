# Copy to .env (never committed). The API and the Prisma CLI both read this file.

# PostgreSQL connection string used by the API and by `prisma migrate`.
DATABASE_URL="postgresql://doktool:CHANGE_ME@127.0.0.1:5432/doktool?schema=public"

# HTTP port of the API.
PORT=3000

# development | test | production
NODE_ENV=development
