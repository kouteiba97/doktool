# Copy to .env (never committed). The API and the Prisma CLI both read this file.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# PostgreSQL connection string used by the API and by `prisma migrate`.
DATABASE_URL="postgresql://doktool:CHANGE_ME@127.0.0.1:5432/doktool?schema=public"

# HTTP port of the API.
PORT=3000

# development | test | production
NODE_ENV=development

# Reverse proxies in front of the API (e.g. 1 behind Cloudflare), for client IPs.
TRUST_PROXY_HOPS=0

# User access tokens (HS256) — at least 32 random characters.
USER_JWT_SECRET=CHANGE_ME_32_RANDOM_CHARACTERS_MINIMUM

# OTP code HMAC key — at least 32 random characters.
OTP_HMAC_SECRET=CHANGE_ME_32_RANDOM_CHARACTERS_MINIMUM

# AES-256 key for admin TOTP secrets: 32 bytes, base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_ENCRYPTION_KEY=

# Exact origin of Admin Web (CSRF check on admin requests).
ADMIN_WEB_ORIGIN=http://localhost:3001

# Version of the terms of use shown at sign-up.
TERMS_VERSION=2026-09

# OTP e-mails. Required in production; in development codes are printed to the API log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="DokTool <no-reply@example.com>"

# Background jobs (pg-boss) in this process.
JOBS_ENABLED=true

# Object storage: local (development) or r2 (required in production — docs/operations/r2-setup.md).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
# Base URL of this API, used in local-driver signed URLs.
PUBLIC_API_URL=http://localhost:3000
# R2_ACCOUNT_ID=
# R2_CONTENT_BUCKET=doktool-content
# R2_CONTENT_ACCESS_KEY_ID=
# R2_CONTENT_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=doktool-private
# R2_PRIVATE_ACCESS_KEY_ID=
# R2_PRIVATE_SECRET_ACCESS_KEY=
