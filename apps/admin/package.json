{
  "name": "@doktool/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DokTool Admin Web — Next.js console over the /admin/v1 API (no database access).",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@doktool/design-tokens": "0.1.0",
    "@doktool/i18n": "0.1.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "intl-messageformat": "12.1.2",
    "lucide-react": "1.48.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@doktool/api-contract": "0.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
