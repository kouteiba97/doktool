<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android backup or device transfer (Android 12+): the session
     keys are bound to this device's Keystore, and the offline reference store, the activity and
     analytics queues are rebuilt from the account after sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
