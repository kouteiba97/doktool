{
  "name": "doktool",
  "private": true,
  "type": "module",
  "description": "DokTool V1 monorepo — NestJS API, Admin Web (Next.js), Flutter mobile, shared contracts.",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:i18n": "npm run check --workspace @doktool/i18n",
    "check:tokens": "npm run check --workspace @doktool/design-tokens",
    "check:openapi": "npm run openapi:check --workspace @doktool/api",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run check:i18n && npm run check:tokens && npm run check:openapi && npm run check:admin-api && npm run test",
    "check:admin-api": "npm run check:api --workspace @doktool/admin"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@swc/core@1.16.2": true,
    "@scarf/scarf": false
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  }
}
