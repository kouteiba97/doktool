{
  "name": "@doktool/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Token gates and generators: tokens.json → CSS/Tailwind/TS drift checks, and the generated Flutter theme.",
  "scripts": {
    "check": "node scripts/check-drift.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "generate:dart": "node scripts/generate-dart.mjs",
    "generate:web": "node scripts/generate-web.mjs"
  },
  "exports": {
    "./tailwind-preset": "./web/tailwind-preset.mjs",
    "./tokens.css": "./web/tokens.css"
  }
}
