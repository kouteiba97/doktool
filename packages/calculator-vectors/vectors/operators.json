    {
      "name": "conditionals",
      "description": "piecewise (first match), if, comparisons, and/or/not, eq/ne",
      "definition": {
        "schemaVersion": 1,
        "inputs": [
          {
            "kind": "NUMBER",
            "key": "a",
            "label": {
              "fr": "Valeur a",
              "en": "Value a"
            },
            "required": true,
            "quantity": "ABSTRACT",
            "canonicalUnit": "1"
          },
          {
            "kind": "NUMBER",
            "key": "b",
            "label": {
              "fr": "Valeur b",
              "en": "Value b"
            },
            "required": true,
            "quantity": "ABSTRACT",
            "canonicalUnit": "1"
          }
        ],
        "formula": {
          "op": "piecewise",
          "cases": [
            {
              "when": {
                "op": "lt",
                "args": [
                  {
                    "input": "a"
                  },
                  {
                    "num": 0
                  }
                ]
              },
              "then": {
                "num": -1
              }
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "input": "a"
                  },
                  {
                    "num": 0
                  }
                ]
              },
              "then": {
                "num": 0
              }
            },
            {
              "when": {
                "op": "or",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "input": "a"
                      },
                      {
                        "num": 7
                      }
                    ]
                  },
                  {
                    "op": "ne",
                    "args": [
                      {
                        "input": "b"
                      },
                      {
                        "input": "b"
                      }
                    ]
                  }
                ]
              },
              "then": {
                "num": 42
              }
            }
          ],
          "otherwise": {
            "op": "if",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "gt",
                    "args": [
                      {
                        "input": "a"
                      },
                      {
                        "num": 10
                      }
                    ]
                  },
                  {
                    "op": "not",
                    "args": [
                      {
                        "op": "ge",
                        "args": [
                          {
                            "input": "b"
                          },
                          {
                            "num": 5
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "num": 100
              },
              {
                "op": "if",
                "args": [
                  {
                    "op": "le",
                    "args": [
                      {
                        "input": "a"
                      },
                      {
                        "num": 10
                      }
                    ]
                  },
                  {
                    "num": 1
                  },
                  {
                    "num": 2
                  }
                ]
              }
            ]
          }
        },
        "result": {
          "unit": "1",
          "decimals": 2,
          "label": {
            "fr": "Résultat",
            "en": "Result"
          }
        },
        "limitations": {
          "fr": "Vecteur de test, sans usage clinique.",
          "en": "Test vector, no clinical use."
        }
      },
      "cases": [
        {
          "name": "first case",
          "inputs": {
            "a": {
              "value": -3
            },
            "b": {
              "value": 0
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": -1,
            "issues": []
          }
        },
        {
          "name": "equality case",
          "inputs": {
            "a": {
              "value": 0
            },
            "b": {
              "value": 9
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": 0,
            "issues": []
          }
        },
        {
          "name": "or case",
          "inputs": {
            "a": {
              "value": 7
            },
            "b": {
              "value": 9
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": 42,
            "issues": []
          }
        },
        {
          "name": "and/not true",
          "inputs": {
            "a": {
              "value": 20
            },
            "b": {
              "value": 1
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": 100,
            "issues": []
          }
        },
        {
          "name": "and/not false, a > 10",
          "inputs": {
            "a": {
              "value": 20
            },
            "b": {
              "value": 5
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": 2,
            "issues": []
          }
        },
        {
          "name": "a ≤ 10",
          "inputs": {
            "a": {
              "value": 5
            },
            "b": {
              "value": 1
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": 1,
            "issues": []
          }
        }
      ]
