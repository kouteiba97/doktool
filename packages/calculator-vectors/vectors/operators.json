{
  "suite": "operators",
  "groups": [
    {
      "name": "arithmetic",
      "description": "add, sub, mul, div and n-ary sum: (a+b) + (a−b) + a·b + a/b",
      "definition": {
        "schemaVersion": 1,
        "inputs": [
          {
            "kind": "NUMBER",
            "key": "a",
            "label": {
              "fr": "Valeur a",
              "en": "Value a"
            },
            "required": true,
            "quantity": "ABSTRACT",
            "canonicalUnit": "1"
          },
          {
            "kind": "NUMBER",
            "key": "b",
            "label": {
              "fr": "Valeur b",
              "en": "Value b"
            },
            "required": true,
            "quantity": "ABSTRACT",
            "canonicalUnit": "1"
          }
        ],
        "formula": {
          "op": "sum",
          "args": [
            {
              "op": "add",
              "args": [
                {
                  "input": "a"
                },
                {
                  "input": "b"
                }
              ]
            },
            {
              "op": "sub",
              "args": [
                {
                  "input": "a"
                },
                {
                  "input": "b"
                }
              ]
            },
            {
              "op": "mul",
              "args": [
                {
                  "input": "a"
                },
                {
                  "input": "b"
                }
              ]
            },
            {
              "op": "div",
              "args": [
                {
                  "input": "a"
                },
                {
                  "input": "b"
                }
              ]
            }
          ]
        },
        "result": {
          "unit": "1",
          "decimals": 2,
          "label": {
            "fr": "Résultat",
            "en": "Result"
          }
        },
        "limitations": {
          "fr": "Vecteur de test, sans usage clinique.",
          "en": "Test vector, no clinical use."
        }
      },
      "cases": [
        {
          "name": "positive operands",
          "inputs": {
            "a": {
              "value": 6
            },
            "b": {
              "value": 3
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": 32,
            "issues": []
          }
        },
        {
          "name": "negative operand",
          "inputs": {
            "a": {
              "value": -2
            },
            "b": {
              "value": 4
            }
          },
          "expected": {
            "outcome": "RESULT",
            "value": -12.5,
            "issues": []
          }
        }
      ]
    },
