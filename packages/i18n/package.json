{
  "name": "@doktool/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-source FR/EN message catalogues (ICU). Compiled to ARB for Flutter and TS for Admin Web.",
  "exports": {
    "./messages.fr.json": "./messages.fr.json",
    "./messages.en.json": "./messages.en.json"
  },
  "scripts": {
    "check": "node scripts/check-parity.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "build:arb": "node scripts/build-arb.mjs",
    "add-keys": "node scripts/add-keys.mjs"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20"
  }
}
