{
  "components": {
    "schemas": {
      "AccessContext": {
        "enum": [
          "AUTHENTICATED",
          "DEMO"
        ],
        "type": "string"
      },
      "AccessProfileDto": {
        "properties": {
          "accessContext": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccessContext"
              }
            ]
          },
          "computedAt": {
            "format": "date-time",
            "type": "string"
          },
          "content": {
            "$ref": "#/components/schemas/ContentRulesDto"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureDecisionDto"
            },
            "type": "array"
          },
          "policyVersion": {
            "example": "2026-09-25.1",
            "type": "string"
          },
          "tier": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EntitlementTier"
              }
            ]
          }
        },
        "required": [
          "accessContext",
          "tier",
          "features",
          "content",
          "computedAt",
          "policyVersion"
        ],
        "type": "object"
      },
      "AccessState": {
        "enum": [
          "AVAILABLE",
          "LOCKED"
        ],
        "type": "string"
      },
      "AdminChallengeKind": {
        "enum": [
          "TOTP_VERIFY",
          "TOTP_ENROLL"
        ],
        "type": "string"
      },
      "AdminMeDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "grants": {
            "description": "Effective (non-expired) grants.",
            "items": {
              "enum": [
                "users.read",
                "users.write",
                "users.suspend",
                "verification.queue.read",
                "verification.review",
                "verification.documents.view",
                "verification.appeal.decide",
                "library.read",
                "library.write",
                "library.disable",
                "calculators.read",
                "calculators.draft",
                "calculators.review",
                "calculators.publish",
                "calculators.retire",
                "subscriptions.read",
                "subscriptions.plans.write",
                "transactions.read",
                "transactions.adjustment.request",
                "transactions.adjustment.approve",
                "finance.read",
                "finance.expenses.write",
                "finance.reports.export",
                "analytics.read",
                "analytics.export",
                "audit.read",
                "audit.export",
                "system.roles.write",
                "system.settings.write",
                "system.notifications.send",
                "system.demo.configure"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "grants"
        ],
        "type": "object"
      },
      "AdminSignInDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "AdminSignInStepDto": {
        "properties": {
          "challengeToken": {
            "description": "Send back with the TOTP code; valid 5 minutes.",
            "type": "string"
          },
          "enrollment": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TotpEnrollmentDto"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "next": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AdminChallengeKind"
              }
            ]
          }
        },
        "required": [
          "next",
          "challengeToken",
          "expiresAt",
          "enrollment"
        ],
        "type": "object"
      },
      "AdminTotpDto": {
        "properties": {
          "challengeToken": {
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          }
        },
        "required": [
          "challengeToken",
          "code"
        ],
        "type": "object"
      },
      "AuthTokensDto": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "description": "Store in secure storage; single use (rotated on refresh).",
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "sessionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ],
        "type": "object"
      },
      "ConfirmSignUpDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "challengeId",
          "code",
          "device"
        ],
        "type": "object"
      },
      "ContentRuleDto": {
        "properties": {
          "lockReason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LockReason"
              }
            ]
          },
          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ContentScope"
              }
            ]
          },
          "unlockPath": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UnlockPath"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "scope",
          "lockReason",
          "unlockPath"
        ],
        "type": "object"
      },
      "ContentRulesDto": {
        "properties": {
          "calculators": {
            "$ref": "#/components/schemas/ContentRuleDto"
          },
          "referenceDocuments": {
            "$ref": "#/components/schemas/ContentRuleDto"
          }
        },
        "required": [
          "calculators",
          "referenceDocuments"
        ],
        "type": "object"
      },
      "ContentScope": {
        "enum": [
          "ALL",
          "STUDENT_TIER",
          "DEMO_SAMPLE",
          "NONE"
        ],
        "type": "string"
      },
      "DemoContext": {
        "description": "Médecin or Résident.",
        "enum": [
          "DOCTOR",
          "RESIDENT"
        ],
        "type": "string"
      },
      "DemoSessionDto": {
        "properties": {
          "accessToken": {
            "description": "Demo access token (audience doktool-demo), valid 1 hour.",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "demoContext": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DemoContext"
              }
            ]
          },
          "demoSessionId": {
            "format": "uuid",
            "type": "string"
          },
          "renewalToken": {
            "description": "Keep in secure storage; trades for new access tokens from this device.",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "demoSessionId",
          "demoContext",
          "renewalToken"
        ],
        "type": "object"
      },
      "DemoTokenDto": {
        "properties": {
          "accessToken": {
            "description": "Demo access token (audience doktool-demo), valid 1 hour.",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt"
        ],
        "type": "object"
      },
      "DeviceDto": {
        "properties": {
          "id": {
            "description": "Installation id generated by the app and kept in secure storage.",
            "type": "string"
          },
          "name": {
            "example": "Pixel 8",
            "type": "string"
          },
          "platform": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DevicePlatform"
              }
            ]
          }
        },
        "required": [
          "id",
          "platform"
        ],
        "type": "object"
      },
      "DevicePlatform": {
        "enum": [
          "IOS",
          "ANDROID"
        ],
        "type": "string"
      },
      "EntitlementTier": {
        "enum": [
          "DEMO",
          "STUDENT",
          "PROFESSIONAL_UNPAID",
          "PROFESSIONAL",
          "RESTRICTED"
        ],
        "type": "string"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "INVALID_CREDENTIALS",
              "SESSION_INVALID",
              "FORBIDDEN",
              "ACCOUNT_SUSPENDED",
              "IDENTIFIER_NOT_CONFIRMED",
              "ORIGIN_NOT_ALLOWED",
              "FEATURE_LOCKED",
              "NOT_FOUND",
              "ACCOUNT_EXISTS",
              "PROFILE_ALREADY_SET",
              "OTP_INVALID",
              "OTP_EXPIRED",
              "TOTP_INVALID",
              "CHALLENGE_INVALID",
              "ACCOUNT_LOCKED",
              "OTP_LOCKED",
              "OTP_RESEND_TOO_SOON",
              "OTP_SEND_LIMIT",
              "RATE_LIMITED",
              "CHANNEL_UNAVAILABLE"
            ],
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetailsBody"
          },
          "message": {
            "description": "For developers and logs; clients display their own translation.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "type": "object"
      },
      "ErrorDetailsBody": {
        "properties": {
          "attemptsRemaining": {
            "type": "number"
          },
          "fields": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "lockReason": {
            "description": "FEATURE_LOCKED only.",
            "type": "string"
          },
          "retryAt": {
            "format": "date-time",
            "type": "string"
          },
          "unlockPath": {
            "description": "FEATURE_LOCKED only.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FeatureDecisionDto": {
        "properties": {
          "key": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FeatureKey"
              }
            ]
          },
          "lockReason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LockReason"
              }
            ],
            "nullable": true
          },
          "readOnly": {
            "description": "Available for reading only.",
            "type": "boolean"
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccessState"
              }
            ]
          },
          "unlockPath": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UnlockPath"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "key",
          "state",
          "lockReason",
          "unlockPath",
          "readOnly"
        ],
        "type": "object"
      },
      "FeatureKey": {
        "enum": [
          "search",
          "reference.view",
          "calculator.use",
          "favorites",
          "activity.history",
          "offline.sync",
          "subscription.purchase",
          "profile.edit"
        ],
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "checkedAt": {
            "example": "2026-09-25T10:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "checkedAt"
        ],
        "type": "object"
      },
      "Language": {
        "enum": [
          "FR",
          "EN"
        ],
        "type": "string"
      },
      "LockReason": {
        "enum": [
          "DEMO_LIMIT",
          "PROFESSIONAL_ONLY",
          "SUBSCRIPTION_REQUIRED",
          "VERIFICATION_REQUIRED",
          "VERIFICATION_PENDING",
          "ACCOUNT_SUSPENDED",
          "OFFLINE_UNAVAILABLE",
          "NO_LONGER_AVAILABLE"
        ],
        "type": "string"
      },
      "MeDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "nullable": true,
            "type": "string"
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "firstName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "description": "E.164",
            "nullable": true,
            "type": "string"
          },
          "phoneConfirmed": {
            "type": "boolean"
          },
          "preferences": {
            "$ref": "#/components/schemas/PreferencesDto"
          },
          "professionalProfile": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfessionalProfileDto"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "wilaya": {
            "$ref": "#/components/schemas/WilayaDto"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "phone",
          "emailConfirmed",
          "phoneConfirmed",
          "wilaya",
          "professionalProfile",
          "preferences",
          "createdAt"
        ],
        "type": "object"
      },
      "OtpChallengeDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "channel": {
            "enum": [
              "EMAIL",
              "SMS"
            ],
            "type": "string"
          },
          "destinationHint": {
            "example": "a•••@example.dz",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "resendAvailableAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "channel",
          "destinationHint",
          "expiresAt",
          "resendAvailableAt"
        ],
        "type": "object"
      },
      "PasswordResetConfirmDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          },
          "newPassword": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code",
          "newPassword"
        ],
        "type": "object"
      },
      "PasswordResetRequestDto": {
        "properties": {
          "identifier": {
            "description": "E-mail address or mobile number.",
            "type": "string"
          },
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Language"
              }
            ],
            "default": "FR"
          }
        },
        "required": [
          "identifier"
        ],
        "type": "object"
      },
      "PreferencesDto": {
        "properties": {
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Language"
              }
            ]
          },
          "theme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ThemePreference"
              }
            ]
          },
          "weightUnitDefault": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WeightUnit"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "language",
          "theme",
          "weightUnitDefault"
        ],
        "type": "object"
      },
      "ProfessionalProfileDto": {
        "properties": {
          "academicYear": {
            "maximum": 7,
            "minimum": 1,
            "nullable": true,
            "type": "number"
          },
          "institutionId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "professionalType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfessionalType"
              }
            ]
          },
          "residencyYear": {
            "minimum": 1,
            "nullable": true,
            "type": "number"
          },
          "specialtyId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "universityId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "professionalType",
          "specialtyId",
          "institutionId",
          "universityId",
          "academicYear",
          "residencyYear"
        ],
        "type": "object"
      },
      "ProfessionalType": {
        "enum": [
          "DOCTOR",
          "RESIDENT",
          "STUDENT"
        ],
        "type": "string"
      },
      "RefreshDto": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken",
          "deviceId"
        ],
        "type": "object"
      },
      "RenewDemoTokenDto": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "renewalToken": {
            "type": "string"
          }
        },
        "required": [
          "renewalToken",
          "deviceId"
        ],
        "type": "object"
      },
      "ResendCodeDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Language"
              }
            ],
            "default": "FR"
          }
        },
        "required": [
          "challengeId"
        ],
        "type": "object"
      },
      "SessionDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "description": "True for the session making this request.",
            "type": "boolean"
          },
          "deviceName": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string"
          },
          "platform": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DevicePlatform"
              }
            ]
          }
        },
        "required": [
          "id",
          "deviceName",
          "platform",
          "createdAt",
          "lastUsedAt",
          "current"
        ],
        "type": "object"
      },
      "SetProfessionalProfileDto": {
        "properties": {
          "academicYear": {
            "description": "Medical students only.",
            "maximum": 7,
            "minimum": 1,
            "type": "number"
          },
          "institutionId": {
            "format": "uuid",
            "type": "string"
          },
          "professionalType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfessionalType"
              }
            ]
          },
          "residencyYear": {
            "description": "Residents only.",
            "minimum": 1,
            "type": "number"
          },
          "specialtyId": {
            "format": "uuid",
            "type": "string"
          },
          "universityId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "professionalType"
        ],
        "type": "object"
      },
      "SignInDto": {
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          },
          "identifier": {
            "description": "E-mail address or mobile number.",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password",
          "device"
        ],
        "type": "object"
      },
      "SignUpDto": {
        "properties": {
          "acceptTerms": {
            "description": "Must be true: the person accepted the terms shown.",
            "type": "boolean"
          },
          "firstName": {
            "maxLength": 80,
            "type": "string"
          },
          "identifier": {
            "description": "E-mail address or mobile number.",
            "example": "amina@example.dz",
            "type": "string"
          },
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Language"
              }
            ],
            "default": "FR"
          },
          "lastName": {
            "maxLength": 80,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "termsVersion": {
            "description": "Version of the terms the app displayed.",
            "type": "string"
          },
          "wilayaCode": {
            "example": 16,
            "type": "number"
          }
        },
        "required": [
          "identifier",
          "password",
          "firstName",
          "lastName",
          "wilayaCode",
          "acceptTerms",
          "termsVersion"
        ],
        "type": "object"
      },
      "StartDemoDto": {
        "properties": {
          "demoContext": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DemoContext"
              }
            ],
            "description": "Médecin or Résident."
          },
          "deviceId": {
            "description": "Installation id generated by the app (stored hashed).",
            "type": "string"
          }
        },
        "required": [
          "demoContext",
          "deviceId"
        ],
        "type": "object"
      },
      "ThemePreference": {
        "enum": [
          "LIGHT",
          "DARK",
          "SYSTEM"
        ],
        "type": "string"
      },
      "TotpEnrollmentDto": {
        "properties": {
          "otpauthUri": {
            "description": "otpauth:// URI, to render as a QR code.",
            "type": "string"
          },
          "secretBase32": {
            "description": "Base32 secret, for manual entry in an authenticator app.",
            "type": "string"
          }
        },
        "required": [
          "secretBase32",
          "otpauthUri"
        ],
        "type": "object"
      },
      "UnlockPath": {
        "enum": [
          "auth.sign-up",
          "subscription.plans",
          "onboarding.role",
          "verification.start",
          "verification.status"
        ],
        "type": "string"
      },
      "UpdatePreferencesDto": {
        "properties": {
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Language"
              }
            ]
          },
          "theme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ThemePreference"
              }
            ]
          },
          "weightUnitDefault": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WeightUnit"
              }
            ],
            "nullable": true
          }
        },
        "type": "object"
      },
      "WeightUnit": {
        "enum": [
          "KG",
          "LB"
        ],
        "type": "string"
      },
      "WilayaDto": {
        "properties": {
          "code": {
            "example": 16,
            "type": "number"
          },
          "name": {
            "example": "Alger",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "admin": {
        "in": "cookie",
        "name": "__Host-doktool_admin",
        "type": "apiKey"
      },
      "demo": {
        "bearerFormat": "JWT",
        "description": "Demo token (audience doktool-demo)",
        "scheme": "bearer",
        "type": "http"
      },
      "user": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
